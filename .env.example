# AI API 配置
# 至少配置其中一个，AI 生成功能才能工作
# 如果都不配置，会使用 Mock 生成（固定游戏）

# 火山引擎 Agent Plan（推荐）
# 获取地址：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
VOLCENGINE_API_KEY=your-api-key-here
# Endpoint ID：https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
VOLCENGINE_ENDPOINT_ID=ep-xxxxxxxx

# Anthropic Claude API
# 获取地址：https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API
# 获取地址：https://platform.openai.com/
# OPENAI_API_KEY=sk-...

# 本地开发服务端口
PORT=4000
