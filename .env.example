# ============================================================
# AI Kids 环境变量示例
# 本地开发：复制为 .env 并填入真实值（server/ 会自动加载根目录 .env）
# Vercel：在 Project Settings → Environment Variables 中配置
# ============================================================

# 火山方舟 API Key（内置模型与火山方舟自定义模型共用）
# 获取：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
VOLCENGINE_API_KEY=your-api-key-here

# 内置模型接口地址（可选，默认火山方舟 Chat Completions）
# 本地 UAT 可指向测试桩：http://localhost:4999/v1/chat/completions
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 推理接入点 ID（ep-xxx）
# 获取：https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
# 注意：只填一次 ep- 前缀；控制台第二行的 ep-2026... 才是接入点 ID
DOUBAO_ENDPOINT_ID=ep-xxxxxxxx
DEEPSEEK_ENDPOINT_ID=ep-yyyyyyyy

# V3.1 遗留变量：DOUBAO_ENDPOINT_ID 未配置时作为回退
# VOLCENGINE_ENDPOINT_ID=ep-xxxxxxxx

# 默认模型：doubao | deepseek（未设置时优先 doubao，否则第一个可用模型）
GAME_MODEL=doubao

# 自定义模型域名白名单（逗号分隔；设置后覆盖默认白名单）
# 默认：ark.cn-beijing.volces.com,api.deepseek.com,api.openai.com,
#       open.bigmodel.cn,dashscope.aliyuncs.com,api.moonshot.cn
# ALLOWED_MODEL_HOSTS=ark.cn-beijing.volces.com,api.deepseek.com

# 是否允许 localhost 自定义模型（仅本地 UAT 使用，生产不要开启）
# ALLOW_LOCAL_MODEL_HOSTS=1

# 模型测试超时（毫秒，默认 20000，范围 1000-60000）
# MODEL_TEST_TIMEOUT_MS=20000

# 游戏生成超时（毫秒，默认 280000，需低于 Vercel maxDuration 300s）
# MODEL_TIMEOUT_MS=280000

# V3.3 Remix：完整源码预算（字符，默认 32000，范围 8000-120000）
# 超过预算时自动降级为「结构摘要 + 关键代码片段」
# REMIX_SOURCE_MAX_CHARS=32000

# V3.3 Remix：输出 token 上限（默认 16384，范围 4096-32000）
# Remix 需要输出完整 HTML，因此高于普通生成的 8192
# REMIX_MAX_TOKENS=16384

# 本地开发服务端口（仅 server/ 使用）
PORT=4000

# Vercel Dashboard 额外建议配置：
# NODEJS_HELPERS=0  （使用 Hono 时避免 Vercel Node 助手冲突）
