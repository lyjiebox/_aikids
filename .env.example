# 火山方舟（Responses API）— 生产 / 本地均需配置
# API Key：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
VOLCENGINE_API_KEY=your-api-key-here
# 推理接入点 ID（ep-xxx）：https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
VOLCENGINE_ENDPOINT_ID=ep-xxxxxxxx

# 本地开发服务端口（仅 server/ 使用）
PORT=4000
