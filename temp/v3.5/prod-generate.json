{"success":true,"data":{"title":"小动物接星星","gameHtml":"<!DOCTYPE html>\n<html lang='zh-CN'>\n<head>\n    <meta charset='UTF-8'>\n    <meta name='viewport' content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no'>\n    <title>小动物接星星</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n            font-family: 'Arial', sans-serif;\n        }\n        body {\n            overflow: hidden;\n            background: linear-gradient(#87CEEB, #191970);\n        }\n        #game-area {\n            width: 100vw;\n            height: 100vh;\n            position: relative;\n            overflow: hidden;\n        }\n        #info {\n            position: absolute;\n            top: 10px;\n            left: 10px;\n            font-size: 22px;\n            font-weight: bold;\n            color: white;\n            z-index: 10;\n            text-shadow: 2px 2px 2px rgba(0,0,0,0.3);\n        }\n        #player {\n            position: absolute;\n            bottom: 50px;\n            left: 50%;\n            transform: translateX(-50%);\n            width: 80px;\n            height: 80px;\n            background: #FFB6C1;\n            border-radius: 50%;\n            cursor: grab;\n            z-index: 5;\n        }\n        #player::before, #player::after {\n            content: '';\n            position: absolute;\n            top: -20px;\n            width: 25px;\n            height: 40px;\n            background: #FFB6C1;\n            border-radius: 50% 50% 0 0;\n        }\n        #player::before {\n            left: 10px;\n        }\n        #player::after {\n            right: 10px;\n        }\n        .star {\n            position: absolute;\n            top: -30px;\n            font-size: 32px;\n            color: #FFD700;\n            text-shadow: 0 0 10px #FFD700;\n            animation: twinkle 1s infinite alternate;\n        }\n        @keyframes twinkle {\n            from { opacity: 0.7; }\n            to { opacity: 1; }\n        }\n        #modal {\n            position: fixed;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            background: white;\n            padding: 35px;\n            border-radius: 20px;\n            box-shadow: 0 8px 20px rgba(0,0,0,0.2);\n            text-align: center;\n            z-index: 999;\n            display: none;\n        }\n        #modal h2 {\n            font-size: 28px;\n            margin-bottom: 15px;\n            color: #333;\n        }\n        #modal p {\n            font-size: 20px;\n            margin-bottom: 20px;\n            color: #666;\n        }\n        #restart-btn {\n            padding: 12px 30px;\n            font-size: 20px;\n            background: #4CAF50;\n            color: white;\n            border: none;\n            border-radius: 12px;\n            cursor: pointer;\n            transition: background 0.3s;\n        }\n        #restart-btn:hover {\n            background: #45a049;\n        }\n    </style>\n</head>\n<body>\n    <div id='game-area'>\n        <div id='info'>\n            分数：<span id='score'>0</span> | 剩余时间：<span id='time'>45</span>s\n        </div>\n        <div id='player'></div>\n        <div id='modal'>\n            <h2 id='modal-title'></h2>\n            <p id='modal-score'></p>\n            <button id='restart-btn'>再玩一次</button>\n        </div>\n    </div>\n\n    <script>\n        const gameArea = document.getElementById('game-area');\n        const player = document.getElementById('player');\n        const scoreEl = document.getElementById('score');\n        const timeEl = document.getElementById('time');\n        const modal = document.getElementById('modal');\n        const modalTitle = document.getElementById('modal-title');\n        const modalScore = document.getElementById('modal-score');\n        const restartBtn = document.getElementById('restart-btn');\n\n        let score = 0;\n        let time = 45;\n        let gameOver = false;\n        let timeTimer = null;\n        let spawnTimer = null;\n\n        // 初始化游戏\n        function init() {\n            bindEvents();\n            startGame();\n        }\n\n        // 开始游戏\n        function startGame() {\n            score = 0;\n            time = 45;\n            gameOver = false;\n            scoreEl.textContent = score;\n            timeEl.textContent = time;\n            modal.style.display = 'none';\n            \n            // 清空所有星星\n            document.querySelectorAll('.star').forEach(s => s.remove());\n            \n            // 计时器\n            timeTimer = setInterval(() => {\n                time--;\n                timeEl.textContent = time;\n                if (time <= 0) {\n                    endGame(false);\n                }\n            }, 1000);\n\n            // 生成星星\n            spawnTimer = setInterval(spawnStar, 1200);\n        }\n\n        // 生成星星\n        function spawnStar() {\n            if (gameOver) return;\n            const star = document.createElement('div');\n            star.className = 'star';\n            star.textContent = '★';\n            star.style.left = Math.random() * (gameArea.offsetWidth - 40) + 'px';\n            gameArea.appendChild(star);\n\n            // 星星下落\n            const fallTimer = setInterval(() => {\n                if (gameOver) {\n                    clearInterval(fallTimer);\n                    return;\n                }\n                const top = parseInt(window.getComputedStyle(star).top);\n                if (top > gameArea.offsetHeight) {\n                    star.remove();\n                    clearInterval(fallTimer);\n                    return;\n                }\n                star.style.top = top + 3 + 'px';\n\n                // 碰撞检测\n                if (isCollide(star, player)) {\n                    score++;\n                    scoreEl.textContent = score;\n                    // <!-- SFX: collect_star -->\n                    star.remove();\n                    clearInterval(fallTimer);\n                    \n                    // 胜利判断\n                    if (score >= 10) {\n                        endGame(true);\n                    }\n                }\n            }, 30);\n        }\n\n        // 碰撞检测\n        function isCollide(a, b) {\n            const aRect = a.getBoundingClientRect();\n            const bRect = b.getBoundingClientRect();\n            return !(aRect.right < bRect.left || aRect.left > bRect.right || aRect.bottom < bRect.top || aRect.top > bRect.bottom);\n        }\n\n        // 结束游戏\n        function endGame(isWin) {\n            gameOver = true;\n            clearInterval(timeTimer);\n            clearInterval(spawnTimer);\n            \n            if (isWin) {\n                modalTitle.textContent = '🎉 太棒了！你赢了！';\n                // <!-- SFX: win -->\n            } else {\n                modalTitle.textContent = '⏰ 时间到啦！';\n                // <!-- SFX: lose -->\n            }\n            modalScore.textContent = `你的得分：${score}分`;\n            modal.style.display = 'block';\n        }\n\n        // 绑定事件\n        function bindEvents() {\n            // 键盘控制\n            document.addEventListener('keydown', (e) => {\n                if (gameOver) return;\n                if (e.key === 'ArrowLeft') movePlayer(-20);\n                if (e.key === 'ArrowRight') movePlayer(20);\n            });\n\n            // 鼠标拖拽\n            player.addEventListener('mousedown', (e) => {\n                if (gameOver) return;\n                const offsetX = e.clientX - player.getBoundingClientRect().left;\n                function onMouseMove(e) {\n                    if (gameOver) return;\n                    const newLeft = e.clientX - offsetX - gameArea.getBoundingClientRect().left;\n                    movePlayerTo(newLeft);\n                }\n                function onMouseUp() {\n                    document.removeEventListener('mousemove', onMouseMove);\n                    document.removeEventListener('mouseup', onMouseUp);\n                }\n                document.addEventListener('mousemove', onMouseMove);\n                document.addEventListener('mouseup', onMouseUp);\n            });\n\n            // 触屏拖拽\n            player.addEventListener('touchstart', (e) => {\n                e.preventDefault();\n                if (gameOver) return;\n                const touch = e.touches[0];\n                const offsetX = touch.clientX - player.getBoundingClientRect().left;\n                function onTouchMove(e) {\n                    e.preventDefault();\n                    if (gameOver) return;\n                    const touch = e.touches[0];\n                    const newLeft = touch.clientX - offsetX - gameArea.getBoundingClientRect().left;\n                    movePlayerTo(newLeft);\n                }\n                function onTouchEnd() {\n                    document.removeEventListener('touchmove', onTouchMove);\n                    document.removeEventListener('touchend', onTouchEnd);\n                }\n                document.addEventListener('touchmove', onTouchMove);\n                document.addEventListener('touchend', onTouchEnd);\n            });\n\n            // 重玩按钮\n            restartBtn.addEventListener('click', startGame);\n        }\n\n        // 移动玩家\n        function movePlayer(dx) {\n            const currentLeft = parseInt(window.getComputedStyle(player).left);\n            const newLeft = currentLeft + dx;\n            movePlayerTo(newLeft);\n        }\n\n        // 移动玩家到指定位置\n        function movePlayerTo(x) {\n            const maxLeft = gameArea.offsetWidth - player.offsetWidth;\n            const finalLeft = Math.max(0, Math.min(x, maxLeft));\n            player.style.left = finalLeft + 'px';\n        }\n\n        // 页面加载完成启动游戏\n        window.addEventListener('load', init);\n    </script>\n</body>\n</html>","engine":"volcengine","model":"doubao","modelName":"Doubao Seed 2.0 Pro","modelSource":"env"}}